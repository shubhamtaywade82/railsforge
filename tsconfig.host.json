{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "mocha"],
    "rootDir": "test-host",
    "outDir": "out/test-host",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["test-host/**/*.ts"]
}
